#pragma once
namespace std {
template <class T> constexpr const T& min(const T& a, const T& b) { return b < a ? b : a; }
template <class T> constexpr const T& max(const T& a, const T& b) { return a < b ? b : a; }
template <class T> inline void swap(T& a, T& b) { T t = a; a = b; b = t; }
template <class T, class U> inline void fill(T* first, T* last, const U& v) { for (; first != last; ++first) *first = v; }
template <class I, class O> inline O copy(I first, I last, O out) { for (; first != last; ++first, ++out) *out = *first; return out; }
}
